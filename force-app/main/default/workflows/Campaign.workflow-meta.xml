    <rules>
        <fullName>Class - Campaign Name</fullName>
        <actions>
            <name>Campaign_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Automatically updates the Campaign Name for Womens Classes</description>
        <formula>AND(
OR(TEXT(Type) = &quot;Class - Women&quot;,  TEXT(Type) = &quot;Class - Community&quot;),
Name &lt;&gt;
IF(
ISPICKVAL(Special_Class__c, &quot;Women&quot;),


TEXT(YEAR(StartDate))+&quot;-&quot;

+LPAD(TEXT(MONTH(StartDate )),2,&quot;0&quot;)+&quot;-&quot; +LPAD(TEXT(DAY(StartDate)),2,&quot;0&quot;) &amp; &quot; &quot; &amp;

&quot;COM - &quot; &amp; TEXT(Region__c),


TEXT(YEAR(StartDate))+&quot;-&quot;

+LPAD(TEXT(MONTH(StartDate )),2,&quot;0&quot;)+&quot;-&quot; +LPAD(TEXT(DAY(StartDate)),2,&quot;0&quot;) &amp; &quot; &quot; &amp;

&quot;COM - &quot; &amp; TEXT(Region__c) &amp; &quot; - &quot; &amp; TEXT( Special_Class__c )))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
