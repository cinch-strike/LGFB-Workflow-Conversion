    <fieldUpdates>
        <fullName>Campaign_Name</fullName>
        <description>TEXT(YEAR(StartDate))+&quot;-&quot;
+LPAD(TEXT(MONTH(StartDate )),2,&quot;0&quot;)+&quot;-&quot; +LPAD(TEXT(DAY(StartDate)),2,&quot;0&quot;) &amp; &quot; &quot; &amp;  TEXT(Region__c)</description>
        <field>Name</field>
        <formula>IF(
ISPICKVAL(Special_Class__c, &quot;Women&quot;),


TEXT(YEAR(StartDate))+&quot;-&quot;

+LPAD(TEXT(MONTH(StartDate )),2,&quot;0&quot;)+&quot;-&quot; +LPAD(TEXT(DAY(StartDate)),2,&quot;0&quot;) &amp; &quot; &quot; &amp;

&quot;COM - &quot; &amp; TEXT(Region__c),


TEXT(YEAR(StartDate))+&quot;-&quot;

+LPAD(TEXT(MONTH(StartDate )),2,&quot;0&quot;)+&quot;-&quot; +LPAD(TEXT(DAY(StartDate)),2,&quot;0&quot;) &amp; &quot; &quot; &amp;

&quot;COM - &quot; &amp; TEXT(Region__c) &amp; &quot; - &quot; &amp; TEXT( Special_Class__c ))</formula>
        <name>Campaign Name</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Campaign_Name_Online</fullName>
        <field>Name</field>
        <formula>IF(
ISPICKVAL( Type , &quot;Awareness&quot;),
TEXT(YEAR(StartDate))+&quot;-&quot;
+LPAD(TEXT(MONTH(StartDate )),2,&quot;0&quot;)+&quot;-&quot; +LPAD(TEXT(DAY(StartDate)),2,&quot;0&quot;) &amp; &quot; &quot; &amp; &quot;Awareness&quot;,

IF(AND
(
ISPICKVAL(Type , &quot;Class - Online&quot;),
OR(
ISPICKVAL(Special_Class__c, &quot;All&quot;),
ISPICKVAL(Special_Class__c, &quot;Women&quot;),
ISPICKVAL(Special_Class__c, &quot;Men&quot;))
), 


TEXT(YEAR(StartDate))+&quot;-&quot;
+LPAD(TEXT(MONTH(StartDate )),2,&quot;0&quot;)+&quot;-&quot; +LPAD(TEXT(DAY(StartDate)),2,&quot;0&quot;) &amp; &quot; &quot; &amp; 
&quot;ON - &quot; &amp; TEXT(Online_Content_Type__c ),

TEXT(YEAR(StartDate))+&quot;-&quot;
+LPAD(TEXT(MONTH(StartDate )),2,&quot;0&quot;)+&quot;-&quot; +LPAD(TEXT(DAY(StartDate)),2,&quot;0&quot;) &amp; &quot; &quot; &amp; &quot;ON - &quot; &amp; TEXT(Online_Content_Type__c ) &amp; &quot; - &quot; &amp; TEXT(Special_Class__c))

)</formula>
        <name>Campaign Name Online</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
