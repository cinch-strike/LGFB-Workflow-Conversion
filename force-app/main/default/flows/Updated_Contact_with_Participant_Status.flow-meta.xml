    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
CONTAINS(&quot;Participant&quot;, TEXT([CampaignMember].Attendee_Type__c)), 
OR(ISNEW(),
ISCHANGED([CampaignMember].Status)),
OR(
ISPICKVAL([CampaignMember].Campaign.Type , &quot;Class - Women&quot;),
ISPICKVAL([CampaignMember].Campaign.Type , &quot;Class - Men&quot;),
ISPICKVAL([CampaignMember].Campaign.Type , &quot;Class - Teen&quot;),
ISPICKVAL([CampaignMember].Campaign.Type , &quot;Class - Online&quot;),
ISPICKVAL([CampaignMember].Campaign.Type , &quot;Class - Community&quot;),
[CampaignMember].Campaign.Name = &apos;Rebook&apos;,
[CampaignMember].Campaign.Name = &apos;Referrals&apos;,
[CampaignMember].Campaign.Name = &apos;Paper&apos;
))
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
CONTAINS(&quot;Participant&quot;, TEXT({!myVariable_current.Attendee_Type__c})), 
OR(ISNEW(),
ISCHANGED({!myVariable_current.Status})),
OR(
ISPICKVAL({!myVariable_current.Campaign.Type} , &quot;Class - Women&quot;),
ISPICKVAL({!myVariable_current.Campaign.Type} , &quot;Class - Men&quot;),
ISPICKVAL({!myVariable_current.Campaign.Type} , &quot;Class - Teen&quot;),
ISPICKVAL({!myVariable_current.Campaign.Type} , &quot;Class - Online&quot;),
ISPICKVAL({!myVariable_current.Campaign.Type} , &quot;Class - Community&quot;),
{!myVariable_current.Campaign.Name} = &apos;Rebook&apos;,
{!myVariable_current.Campaign.Name} = &apos;Referrals&apos;,
{!myVariable_current.Campaign.Name} = &apos;Paper&apos;
))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(ISBLANK([CampaignMember].Contact.Region__c ), TEXT([CampaignMember].Campaign.Type) = &quot;Class - Community&quot;)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISBLANK({!myVariable_current.Contact.Region__c} ), TEXT({!myVariable_current.Campaign.Type}) = &quot;Class - Community&quot;)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
ISNEW(), 
ISPICKVAL([CampaignMember].Campaign.Type , &quot;Participant Pre Registration&quot;))
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_7</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISNEW(), 
ISPICKVAL({!myVariable_current.Campaign.Type} , &quot;Participant Pre Registration&quot;))</expression>
    </formulas>
